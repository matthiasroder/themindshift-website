---
import '../styles/global.css'
import Analytics from '../components/Analytics.astro';

interface Props {
  title: string;
  description?: string;
  schema?: Record<string, unknown>;
}

const {
  title,
  description = "The Mindshift helps leadership teams find, redesign, build, and scale the workflows where AI can improve real business outcomes.",
  schema
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title.includes('The Mindshift') ? title : `${title} — The Mindshift`;
const structuredData = schema
  ? JSON.stringify(schema).replace(/</g, '\\u003c')
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Mindshift" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    {structuredData && <script type="application/ld+json" set:html={structuredData} />}
    <title>{pageTitle}</title>
  </head>
  <body class="bg-ms-dark-900 text-white font-sans antialiased">
    <nav aria-label="Main navigation" class="sticky top-0 w-full z-50 bg-ms-dark-900 border-b border-white/5">
      <div class="max-w-6xl mx-auto px-6 h-[calc(var(--site-header-height)-1px)] flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 text-xl font-bold tracking-tight" aria-label="The Mindshift home">
          <img src="/mindshift-logo.svg" alt="" width="40" height="40" class="w-10 h-10" />
          <span><span class="text-white">The </span><span class="text-ms-green-400">Mindshift</span></span>
        </a>
        <div class="hidden lg:flex items-center gap-8 text-sm">
          <a href="/services" class="text-gray-300 hover:text-white transition">Services</a>
          <a href="/work" class="text-gray-300 hover:text-white transition">Work</a>
          <a href="/about" class="text-gray-300 hover:text-white transition">About</a>
          <a href="/insights" class="text-gray-300 hover:text-white transition">Insights</a>
          <a href="/faq" class="text-gray-300 hover:text-white transition">FAQ</a>
          <a href="/services/workflow-scan" data-conversion="ai-workflow-scan" data-placement="header" class="text-ms-body hover:text-white py-2 underline underline-offset-4 decoration-white/30 hover:decoration-ms-green-400 font-semibold transition">
            Find your first workflow
          </a>
        </div>
        <button
          id="mobile-menu-btn"
          class="lg:hidden text-white p-3 -mr-3"
          aria-label="Toggle navigation menu"
          aria-controls="mobile-menu"
          aria-expanded="false"
          type="button"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
      <div id="mobile-menu" class="hidden lg:hidden px-6 pb-4 space-y-3">
        <a href="/services" class="block text-gray-300 hover:text-white">Services</a>
        <a href="/work" class="block text-gray-300 hover:text-white">Work</a>
        <a href="/about" class="block text-gray-300 hover:text-white">About</a>
        <a href="/insights" class="block text-gray-300 hover:text-white">Insights</a>
        <a href="/faq" class="block text-gray-300 hover:text-white">FAQ</a>
        <a href="/services/workflow-scan" data-conversion="ai-workflow-scan" data-placement="mobile-menu" class="block text-ms-body hover:text-white py-2 underline underline-offset-4 decoration-white/30 font-semibold">Find your first workflow</a>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="border-t border-white/5 mt-24">
      <div class="max-w-6xl mx-auto px-6 py-12 flex flex-col md:flex-row items-center justify-between gap-6 text-sm text-ms-muted">
        <div class="flex items-center gap-3">
          <img src="/mindshift-logo.svg" alt="" width="36" height="36" class="w-9 h-9 opacity-90" />
          <span>© 2026 The Mindshift. All rights reserved.</span>
        </div>
        <div class="flex flex-wrap justify-center gap-6">
          <a href="https://matthiasroder.com/" class="hover:text-gray-300 transition">For individuals → MatthiasRöder.com</a>
          <a href="/impressum" class="hover:text-gray-300 transition">Impressum</a>
          <a href="/privacy" class="hover:text-gray-300 transition">Datenschutz</a>
        </div>
      </div>
    </footer>

    <script>
      const mobileMenuButton = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');

      mobileMenuButton?.addEventListener('click', () => {
        mobileMenu?.classList.toggle('hidden');
        const isExpanded = mobileMenu ? !mobileMenu.classList.contains('hidden') : false;
        mobileMenuButton.setAttribute('aria-expanded', String(isExpanded));
      });
    </script>
    <Analytics />
  </body>
</html>
