---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="IMZ Academy AI Agents Workshop"
  description="IMZ Academy workshop on AI Agents for Content Creation + Administration with Matthias Röder in Vienna."
>
  <header class="mx-auto max-w-6xl px-6 pt-14 pb-10 md:pt-20 md:pb-14">
    <p class="mb-6 text-sm font-semibold uppercase tracking-[0.18em] text-ms-green-400">IMZ Academy · Workshop</p>
    <div class="grid gap-7 md:grid-cols-[1fr_auto] md:items-end">
      <div>
        <h1 class="text-5xl font-bold tracking-[-0.055em] sm:text-6xl md:text-8xl">AI Agents</h1>
        <p class="mt-3 text-xl font-medium tracking-tight text-ms-body sm:text-2xl">for Content Creation + Administration</p>
      </div>
      <dl class="event-details grid grid-cols-2 gap-x-7 gap-y-2 border-l border-ms-green-400/60 pl-4 text-sm md:mb-1">
        <dt class="text-ms-muted">Date</dt>
        <dd><time datetime="2026-11-05">5 Nov 2026</time></dd>
        <dt class="text-ms-muted">Location</dt>
        <dd>Vienna</dd>
      </dl>
    </div>
    <p class="mt-7 max-w-xl leading-relaxed text-ms-body">
      A hands-on workshop with Matthias Röder on using AI agents for creation, research and administration in music and media.
    </p>
    <a href="https://www.imz.at/ai-agents/" class="mt-4 inline-block text-sm font-medium text-ms-green-300 underline underline-offset-4">Workshop programme at IMZ</a>
  </header>
</Layout>

<style>
  .event-details { max-width: max-content; }
</style>
