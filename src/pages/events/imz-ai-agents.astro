---
import { existsSync, readdirSync } from 'node:fs';
import { resolve } from 'node:path';
import Layout from '../../layouts/Layout.astro';

const photoPath = '/images/events/imz-ai-agents';
const photoDir = resolve('public', photoPath.slice(1));
const photos = existsSync(photoDir)
  ? readdirSync(photoDir).filter((name) => /^\d{6}-[a-f0-9]{24}\.jpg$/.test(name)).sort()
  : [];
---

<Layout
  title="IMZ Academy AI Agents Workshop"
  description="Photos from the IMZ Academy AI Agents for Content Creation + Administration workshop with Matthias Röder in Vienna."
>
  <header class="mx-auto max-w-6xl px-6 pt-14 pb-10 md:pt-20 md:pb-14">
    <p class="mb-6 text-sm font-semibold uppercase tracking-[0.18em] text-ms-green-400">IMZ Academy · Workshop</p>
    <div class="grid gap-7 md:grid-cols-[1fr_auto] md:items-end">
      <div>
        <h1 class="text-5xl font-bold tracking-[-0.055em] sm:text-6xl md:text-8xl">AI Agents</h1>
        <p class="mt-3 text-xl font-medium tracking-tight text-ms-body sm:text-2xl">for Content Creation + Administration</p>
      </div>
      <dl class="event-details grid grid-cols-2 gap-x-7 gap-y-2 border-l border-ms-green-400/60 pl-4 text-sm md:mb-1">
        <dt class="text-ms-muted">Date</dt>
        <dd><time datetime="2026-11-05">5 Nov 2026</time></dd>
        <dt class="text-ms-muted">Location</dt>
        <dd>Vienna</dd>
      </dl>
    </div>
    <p class="mt-7 max-w-xl leading-relaxed text-ms-body">
      A hands-on workshop with Matthias Röder on using AI agents for creation, research and administration in music and media.
    </p>
    <a href="https://www.imz.at/ai-agents/" class="mt-4 inline-block text-sm font-medium text-ms-green-300 underline underline-offset-4">Workshop programme at IMZ</a>
  </header>

  <section class="border-y border-white/10 bg-ms-dark-800" aria-labelledby="photo-stream-title">
    <div class="mx-auto max-w-6xl px-6 pt-9 pb-14 md:pt-11 md:pb-20">
      <h2 id="photo-stream-title" class="mb-6 text-2xl font-semibold tracking-tight">Photo stream</h2>
      {photos.length ? (
        <ol class="grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-3">
          {photos.map((photo, index) => (
            <li>
              <a href={`${photoPath}/${photo}`} class="block overflow-hidden rounded-lg border border-white/10 hover:border-ms-green-400/60">
                <img
                  class="block h-auto w-full"
                  src={`${photoPath}/${photo}`}
                  alt={`IMZ Academy photo stream, image ${index + 1}`}
                  width="1080"
                  height="1920"
                  loading={index < 2 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </a>
            </li>
          ))}
        </ol>
      ) : <p class="text-ms-body">Photos will appear here as they’re added.</p>}
    </div>
  </section>
</Layout>

<style>
  .event-details { max-width: max-content; }
</style>
