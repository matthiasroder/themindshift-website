---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CTA from '../components/CTA.astro';

const faqs = [
  {
    q: "Where should we start?",
    a: "Most organizations start with the €2,500 AI Workflow Scan. Bring two or three candidate workflows from one business area. You receive a management-ready recommendation naming the first workflow worth pursuing and why. If you already have one clearly selected workflow, an AI Work Audit or Workflow Build may be the better starting point."
  },
  {
    q: "How much does this cost?",
    a: "The AI Workflow Scan is €2,500. A Business AI Workshop is €3,500 for a half day or €5,500 for a full day. The AI Work Audit is €10,000. AI Workflow Builds start at €25,000. Organization programs are scoped individually. Prices exclude VAT where applicable."
  },
  {
    q: "What happens in the AI Workflow Scan?",
    a: "The sponsor completes a short questionnaire, brings two or three candidate workflows, and supplies a concise material pack. We compare the candidates in one 90-minute diagnostic session and deliver an AI Workflow Recommendation covering the comparison, recommended workflow, first system outline, expected upside, risks, prerequisites, and next move. We present it in a 45-minute results session."
  },
  {
    q: "We're not a tech company. Is this relevant for us?",
    a: "Especially for you. Tech companies already have AI teams. The Mittelstand (manufacturing, logistics, professional services, healthcare) is where AI creates the biggest relative advantage. You don't need to become a tech company. You need to become a company that uses technology well."
  },
  {
    q: "How is this different from what McKinsey or Accenture offers?",
    a: "They send a team of junior consultants with a framework. We send a senior founder who's actually built AI products. No intermediaries, no 50-page decks designed to justify the next engagement. We're smaller, faster, and more honest about what AI can and can't do."
  },
  {
    q: "How long does the work take?",
    a: "The AI Workflow Scan uses two focused sessions, with the AI Workflow Recommendation normally delivered within five business days of the diagnostic. The AI Work Audit takes two to three weeks. Workflow Builds and organization programs depend on the system, integrations, testing, and adoption involved."
  },
  {
    q: "Do you work with startups?",
    a: "Sometimes. If you're pre-product and need help figuring out where AI fits, yes. If you're looking for a cheap outsourced AI team, no. We're best when there's a real business problem to solve."
  },
  {
    q: "Can you help us pick the right AI tools?",
    a: "Yes, and we're vendor-agnostic. We don't resell software or take referral fees. Our recommendation is based entirely on what fits your needs, your data, your budget, and your team's ability to maintain it."
  },
  {
    q: "What industries do you work with?",
    a: "We've worked across manufacturing, media, financial services, professional services, and the arts. Our approach is transferable. We're not industry specialists, we're AI strategists who learn your industry fast."
  }
];

const germanFaq = {
  q: "Was soll ich tun, wenn ich kein Englisch spreche?",
  a: "Keine Sorge, Dr. Röder spricht fließend Deutsch (und lebt in Salzburg). Die Website ist auf Englisch, weil unsere Arbeit international ist. Ihr Gespräch, Ihr Workshop und alle Unterlagen können selbstverständlich auf Deutsch sein. Rufen Sie einfach an."
};

const allFaqs = [...faqs, germanFaq];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: allFaqs.map(faq => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a
    }
  }))
};
---

<Layout
  title="AI Workflow Consulting Pricing & FAQ"
  description="Answers about The Mindshift's €2,500 AI Workflow Scan, workshops, workflow audits, implementation, timelines, and fit."
  schema={faqSchema}
>

  <PageHero
    label="FAQ"
    title='Questions we actually <span class="text-ms-green-400">get asked.</span>'
  />

  <section class="bg-ms-dark-800 border-y border-white/5">
    <div class="max-w-3xl mx-auto px-6 py-24">
      <div class="space-y-8">
        {allFaqs.map(faq => (
          <div class="border-b border-white/5 pb-8">
            <h3 class="text-xl font-bold mb-4">{faq.q}</h3>
            <p class="text-gray-400 leading-relaxed">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA />

</Layout>
