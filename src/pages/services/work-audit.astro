---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CTA from '../../components/CTA.astro';
---

<Layout title="AI Work Audit" description="Redesign one priority workflow and establish its business case, prototype plan, measurement, and operating rules in two to three weeks.">
  <PageHero label="Redesign the work" title='Turn one AI opportunity into a <span class="text-ms-green-400">buildable workflow.</span>' subtitle="A focused two-to-three-week engagement for organizations that already know which workflow deserves deeper work." />
  <section class="bg-ms-dark-800 border-y border-white/5">
    <div class="max-w-6xl mx-auto px-6 py-24 grid md:grid-cols-2 gap-16">
      <div><p class="text-ms-green-400 text-sm font-semibold uppercase tracking-wider">The work</p><h2 class="mt-4 text-3xl font-bold">Redesign before you automate.</h2><p class="mt-6 text-lg text-gray-400 leading-relaxed">We map the current workflow, identify where AI and human judgment belong, design the future state, and test whether the expected improvement justifies a build.</p></div>
      <div class="bg-ms-dark-900 border border-white/5 rounded-2xl p-8"><p class="text-ms-green-400 text-sm font-semibold uppercase tracking-wider">Outputs</p><ul class="mt-6 space-y-4 text-gray-300"><li>→ Redesigned human-and-AI workflow</li><li>→ Business case and measurement baseline</li><li>→ Prototype and implementation plan</li><li>→ Decision rights and operating rules</li><li>→ Build recommendation</li></ul></div>
    </div>
  </section>
  <CTA headline='Not sure the workflow is ready for an Audit?' sub="The AI Workflow Scan compares the candidates first. No need to redesign the wrong thing with great enthusiasm." />
</Layout>
