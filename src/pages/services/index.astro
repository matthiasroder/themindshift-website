---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CTA from '../../components/CTA.astro';

const pathway = [
  {
    number: '01',
    stage: 'Find the opportunity',
    title: 'AI Workflow Scan',
    href: '/services/workflow-scan',
    text: 'Bring two or three candidate workflows. Leave with a management-ready recommendation naming the first one worth pursuing and why.'
  },
  {
    number: '02',
    stage: 'Redesign the work',
    title: 'AI Work Audit',
    href: '/services/work-audit',
    text: 'Redesign one priority workflow and unlock tangible gains from day one—while establishing the business case, prototype plan, measurement, and operating rules.'
  },
  {
    number: '03',
    stage: 'Build the system',
    title: 'AI Workflow Build',
    href: '/services/workflow-build',
    text: 'Build and test the complete human-and-AI system: agents, knowledge, tools, integrations, decision rights, training, and measurement.'
  },
  {
    number: '04',
    stage: 'Scale the model',
    title: 'AI-Native Organization Program',
    href: '/services/ai-native-organization',
    text: 'Scale successful patterns across teams with reusable infrastructure, governance, capability-building, and an outcomes-led portfolio.'
  }
];
---

<Layout
  title="AI Workflow Redesign and Implementation"
  description="Find the opportunity, redesign the work, build the system, and scale an AI-native operating model with The Mindshift."
>
  <PageHero
    label="How we work"
    title='One path from AI interest to <span class="text-ms-green-400">better work.</span>'
    subtitle="Start with evidence. Build what works. Scale only after it works."
  />

  <section class="bg-ms-dark-800 border-y border-white/5">
    <div class="max-w-6xl mx-auto px-6 py-24">
      <div class="grid md:grid-cols-2 gap-6">
        {pathway.map((offer, index) => (
          <a href={offer.href} class:list={["group block rounded-2xl p-8 md:p-10 transition-all", index === 0 ? "bg-ms-dark-900 border border-ms-green-500/35" : "bg-ms-dark-700 border border-white/5 hover:border-ms-green-500/30"]}>
            <div class="flex items-start justify-between gap-6">
              <div>
                <p class="text-ms-green-400 text-sm font-semibold uppercase tracking-wider">{offer.number} — {offer.stage}</p>
                <h2 class="mt-4 text-2xl md:text-3xl font-bold group-hover:text-ms-green-400 transition">{offer.title}</h2>
              </div>
              {index === 0 && <span class="shrink-0 bg-ms-green-500 text-ms-dark-900 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider">Start here</span>}
            </div>
            <p class="mt-5 text-lg text-gray-400 leading-relaxed">{offer.text}</p>
            <p class="mt-8 text-ms-green-400 font-semibold">Explore →</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-ms-dark-900">
    <div class="max-w-6xl mx-auto px-6 py-24 grid lg:grid-cols-[1.1fr_0.9fr] gap-12 items-start">
      <div>
        <p class="text-ms-green-400 text-sm font-semibold uppercase tracking-wider mb-4">Capability when it is needed</p>
        <h2 class="text-3xl md:text-4xl font-bold leading-tight">Workshops support the path. They do not replace it.</h2>
        <p class="mt-6 text-lg text-gray-400 leading-relaxed">A Business AI Workshop creates shared understanding and prioritized use cases when a team needs alignment before or during the work. It can stand alone, but it is not a compulsory toll booth.</p>
        <a href="/services/workshops" class="inline-block mt-8 text-ms-green-400 font-semibold hover:text-ms-green-300 transition">Explore the Business AI Workshop →</a>
      </div>
      <div class="bg-ms-dark-800 border border-white/5 rounded-2xl p-8">
        <p class="text-ms-green-400 text-sm font-semibold uppercase tracking-wider">Implementation proof</p>
        <h3 class="mt-4 text-2xl font-bold">PRGen</h3>
        <p class="mt-4 text-gray-400 leading-relaxed">A config-driven press-release system with customer-specific style, workflow, revisions, exports, feedback, analytics, and administration. The SES pilot is awaiting testing feedback and a 2027 budget decision—promising evidence, not a victory lap.</p>
        <a href="/contact" class="inline-block mt-6 text-ms-green-400 font-semibold hover:text-ms-green-300 transition">Discuss a workflow build →</a>
      </div>
    </div>
  </section>

  <section class="bg-ms-dark-800 border-y border-white/5">
    <div class="max-w-3xl mx-auto px-6 py-20 text-center">
      <p class="text-ms-green-400 text-sm font-semibold uppercase tracking-wider">Looking for personal learning or support?</p>
      <h2 class="mt-4 text-3xl font-bold">MatthiasRöder.com helps people become AI-native.</h2>
      <p class="mt-5 text-gray-400 leading-relaxed">Membership, implementation material, live labs, private sessions, coaching, and speaking live there.</p>
      <a href="https://matthiasroder.com/" class="inline-block mt-7 text-ms-green-400 font-semibold hover:text-ms-green-300 transition">Go to MatthiasRöder.com →</a>
    </div>
  </section>

  <CTA />
</Layout>
